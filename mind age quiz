      tag:"成熟笃行者",cls:"old",
      desc:"你更接近一种通透、克制的心理状态，重视责任与秩序，对热闹和新鲜事的需求不高。",
      deep:"这是一种通透而克制的心理状态，重视秩序与承诺，对热闹的需求不高。很多人在经历之后才抵达这里，你却已经习惯用这样的视角看世界。",
      risk:"成熟有时会把好奇心误判为「没必要」，把情绪表达误判为「不体面」。偶尔松一松，并不会削弱你已有的稳重。",
      tip:"成熟不等于不能再好奇。给自己保留一件「没有用处但喜欢」的小事，会让你更松弛。"
    }
  };

  var $ = function(id){return document.getElementById(id);};
  var answers = new Array(30).fill(null);
  var current = 0;
  var actualAge = 0;
  var advanceTimer = null;
  var resultTimer = null;

  function show(id){
    ["intro","quiz","result"].forEach(function(s){$(s).classList.toggle("active",s===id);});
    $("topHint").textContent = id==="intro" ? "自我探索 · 01" : id==="quiz" ? "自我探索 · 02" : "自我探索 · 03";
    window.scrollTo({top:0,behavior:"auto"});
  }

  function renderQuiz(){
    var item = questions[current];
    $("stepNow").textContent = String(current+1).padStart(2,"0");
    $("dimChip").textContent = item.d;
    var qEl = $("questionText");
    qEl.textContent = item.q;
    qEl.classList.remove("swap");
    void qEl.offsetWidth;
    qEl.classList.add("swap");
    $("progressFill").style.width = ((current+1)/questions.length*100)+"%";
    var box = $("options");
    box.innerHTML = "";
    item.o.forEach(function(opt,i){
      var btn = document.createElement("button");
      btn.type = "button";
      btn.className = "option" + (answers[current]===i ? " selected" : "");
      btn.style.animationDelay = (i*0.055)+"s";
      var key = document.createElement("span");
      key.className = "key";
      key.textContent = "ABCD"[i];
      var text = document.createElement("span");
      text.textContent = opt[0];
      btn.appendChild(key); btn.appendChild(text);
      btn.addEventListener("click",function(){
        answers[current] = i;
        Array.prototype.forEach.call(box.children,function(el,idx){
          el.classList.toggle("selected",idx===i);
        });
        $("nextBtn").disabled = false;
        clearTimeout(advanceTimer);
        advanceTimer = setTimeout(function(){
          if(current < questions.length-1){ current++; renderQuiz(); }
          else { finish(); }
        },280);
      });
      box.appendChild(btn);
    });
    $("prevBtn").disabled = current===0;
    $("nextBtn").textContent = current===questions.length-1 ? "查看结果" : "下一题";
    $("nextBtn").disabled = answers[current]===null;
  }

  function profileFor(diff){
    if(diff<=-5) return profiles.younger;
    if(diff<=-2) return profiles.slightYoung;
    if(diff<=1) return profiles.balanced;
    if(diff<=4) return profiles.slightOld;
    return profiles.older;
  }

  function getDiffText(diff){
    if(diff<0) return "比实际年龄年轻 "+Math.abs(diff)+" 岁";
    if(diff>0) return "比实际年龄成熟 "+diff+" 岁";
    return "与你的实际年龄基本一致";
  }

  function stageText(age){
    if(age<=19) return "你正处在自我边界快速扩张的时期，很多「我是谁」的答案还在形成。此时心理年龄偏年轻非常正常，重要的是在尝试中慢慢辨认出真正属于自己的偏好，而不是急着给自己下定义。";
    if(age<=29) return "二十多岁通常要在方向、关系与独立之间做大量取舍。你的心理年龄会明显受到「是否愿意试错」的影响：愿意多试的人往往显得更年轻，而提前承担较多责任的人会更沉稳。两种节奏都没有错。";
    if(age<=39) return "三十多岁的核心课题，是在稳定与变化之间找到可持续的节奏。工作、关系与自我期待都更具体了，心理年龄偏成熟往往意味着你在认真兑现承诺；若能保留一点无用的好奇，会明显减轻紧绷感。";
    if(age<=49) return "四十多岁的人往往重新审视「我一直在过的生活是不是我想要的」。此时心态年轻，通常来自对新可能的开放；心态成熟，则来自对已有生活的接纳。真正的分水岭不是数字，而是你是否还在主动选择。";
    if(age<=59) return "五十多岁是经验最丰厚、也最容易形成固定结论的阶段。你的心理年龄更多反映了你对变化的姿态：仍愿意学习的人会显得年轻，而重视秩序与传承的人会更显稳重，后者同样是珍贵的力量。";
    return "人生后半程的心理年龄，较少取决于做了多少，而更多取决于如何回望与安放。愿意保持连接、照顾身体、对世界仍有关心的人，往往心态更轻盈；沉静内敛也并非退步，而是另一种从容。";
  }

  function detailFor(name,value){
    var m = dimMeta[name];
    if(value>=65) return m.highDetail;
    if(value>=40) return m.midDetail;
    return m.lowDetail;
  }

  function bandLabel(value){
    if(value>=70) return "很突出";
    if(value>=55) return "较为突出";
    if(value>=40) return "中等水平";
    if(value>=25) return "稍显薄弱";
    return "明显薄弱";
  }

  function countUp(el,target){
    var start = null, duration = 750;
    function frame(ts){
      if(start===null) start=ts;
      var p = Math.min((ts-start)/duration,1);
      var eased = 1-Math.pow(1-p,3);
      el.innerHTML = Math.round(target*eased)+"<small>岁</small>";
      if(p<1) requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  }

  function finish(){
    clearTimeout(advanceTimer);
    clearTimeout(resultTimer);
    var sum = 0, dims = {};
    answers.forEach(function(a,i){
      var s = questions[i].o[a][1];
      sum += s;
      dims[questions[i].d] = (dims[questions[i].d]||0)+s;
    });
    var vitality = Math.round(sum/(questions.length*3)*100);
    var offset = Math.round((50-vitality)*0.16);
    var psych = Math.max(12,Math.min(90,Math.round(actualAge+offset)));
    var diff = psych-actualAge;
    var profile = profileFor(diff);
    var names = Object.keys(dims);
    names.sort(function(a,b){return dims[b]-dims[a];});
    var top = names[0], low = names[names.length-1], secondLow = names[names.length-2];
    function pct(d){ return Math.round(dims[d]/15*100); }

    $("analyzing").classList.add("show");

    resultTimer = setTimeout(function(){
      $("realAge").textContent = actualAge+" 岁";
      $("mindAge").textContent = psych+" 岁";
      $("profileTag").textContent = profile.tag;
      $("profileTag").className = "profile-tag "+profile.cls;
      $("heroDesc").textContent = profile.desc;
      $("diffPill").textContent = getDiffText(diff);
      $("diffPill").className = "diff-pill "+ (diff===0?"same":profile.cls);
      countUp($("psyAge"),psych);

      var lo = Math.max(1,Math.min(actualAge,psych)-6);
      var hi = Math.min(100,Math.max(actualAge,psych)+6);
      if(hi-lo<12){ hi=Math.min(100,lo+12); lo=Math.max(1,hi-12); }
      function pos(v){ return Math.max(4,Math.min(96,(v-lo)/(hi-lo)*100)); }
      var pReal = pos(actualAge), pMind = pos(psych);
      $("scaleLow").textContent = lo+" 岁";
      $("scaleHigh").textContent = hi+" 岁";
      $("actualMarker").style.left = pReal+"%";
      $("mindMarker").style.left = pMind+"%";
      $("actualLabel").style.left = pReal+"%";
      $("mindLabel").style.left = pMind+"%";
      if(diff===0){
        $("mindMarker").style.display = "none";
        $("actualLabel").style.display = "none";
        $("mindLabel").style.left = pMind+"%";
        $("mindLabel").textContent = "实际 = 心理";
      }else{
        $("mindMarker").style.display = "block";
        $("actualLabel").style.display = "block";
        $("mindLabel").textContent = "心理";
      }
      $("scaleFill").style.left = Math.min(pReal,pMind)+"%";
      $("scaleFill").style.width = Math.max(2,Math.abs(pMind-pReal))+"%";

      var analysis = "";
      analysis += '<div class="subhead">01 · 核心结论</div>';
      analysis += '<p>你的心理活力指数为 <b>'+vitality+' / 100</b>，据此推算的心理年龄约为 <b>'+psych+' 岁</b>，'+getDiffText(diff)+'。结合 30 道题目的整体倾向，你的心理画像更接近「<b>'+profile.tag+'</b>」：'+profile.desc+'</p>';
      analysis += '<p>'+profile.deep+'</p>';

      analysis += '<div class="subhead">02 · 年龄差意味着什么</div>';
      analysis += '<div class="diff-story'+(diff>0?" old":"")+'">'+
        '心理年龄不是独立的人格诊断，而是把 30 道题的作答倾向折算成一个可对照的尺度：活力、开放与弹性越多，数值越靠近年轻一侧；沉稳、克制与谨慎越多，数值越靠近成熟一侧。'+
        (diff<0?"你的结果偏向年轻一侧，说明你更愿意尝试，也更容易从新体验中获得能量。":diff>0?"你的结果偏向成熟一侧，说明你更看重判断、责任与秩序。":"你的结果落在两者之间，说明开放与沉稳在你身上并存，彼此并不冲突。")+
        '这个差值更像一种观察视角，而不是需要被修正的误差。</div>';

      analysis += '<div class="subhead">03 · 你的优势与盲点</div>';
      analysis += '<p><b>最突出的维度是「'+top+'」</b>（'+pct(top)+' 分，'+bandLabel(pct(top))+'）。'+dimMeta[top].high+dimMeta[top].highDetail+'</p>';
      analysis += '<p><b>相对薄弱的是「'+low+'」</b>（'+pct(low)+' 分，'+bandLabel(pct(low))+'）。'+dimMeta[low].low+dimMeta[low].lowDetail+'</p>';
      analysis += '<p>'+profile.risk+'</p>';

      analysis += '<div class="subhead">04 · 你所处的人生阶段</div>';
      analysis += '<p>'+stageText(actualAge)+'</p>';

      analysis += '<div class="subhead">05 · 写在最后</div>';
      analysis += '<p>心理年龄没有标准答案，也不是越高越好或越低越棒。年轻代表弹性与好奇，成熟代表稳定与判断力。真正值得关注的，是这份状态能否支撑你想要的生活：如果它让你自在，那就是你的节奏；如果它开始带来困扰，也可以从最想改变的一小部分开始，慢慢调整。</p>';
      $("analysis").innerHTML = analysis;

      var list = $("dimList");
      list.innerHTML = "";
      names.forEach(function(name){
        var value = pct(name);
        var row = document.createElement("div");
        row.className = "dim-row";
        row.innerHTML = '<div class="dim-top"><span>'+name+'</span><span>'+value+' / 100 · '+bandLabel(value)+'</span></div>'+
          '<div class="dim-track"><div class="dim-fill'+(value<40?" low":"")+'" data-width="'+value+'"></div></div>';
        list.appendChild(row);
      });

      var deep = $("deepAnalysis");
      deep.innerHTML = "";
      names.forEach(function(name){
        var value = pct(name);
        var card = document.createElement("div");
        card.className = "insight";
        card.innerHTML =
          '<div class="insight-head"><span class="insight-dot'+(value<40?" gold":"")+'"></span>'+
          '<h4>'+name+'</h4><em>'+value+' / 100 · '+bandLabel(value)+'</em></div>'+
          '<div class="insight-bar"><i class="'+(value<40?"gold":"")+'" data-width="'+value+'"></i></div>'+
          '<p><span>你的模式：</span>'+detailFor(name,value)+'</p>'+
          '<p><span>在关系中：</span>'+dimMeta[name].relation+'</p>'+
          '<p><span>压力下：</span>'+dimMeta[name].stress+'</p>'+
          '<p><span>可以试试：</span>'+dimMeta[name].advice+'</p>';
        deep.appendChild(card);
      });

      requestAnimationFrame(function(){
        Array.prototype.forEach.call(document.querySelectorAll("#result [data-width]"),function(el){
          el.style.width = el.getAttribute("data-width")+"%";
        });
      });

      $("tips").innerHTML =
        "<li>"+dimMeta[low].advice+"</li>"+
        "<li>"+dimMeta[secondLow].advice+"</li>"+
        "<li>"+profile.tip+"</li>"+
        "<li>把「"+top+"」当作你的内在资源：遇到不确定的时候，先想想你在这个维度里最擅长的做法，再把它迁移到薄弱的地方。</li>"+
        "<li>把这次结果当作一个起点。三个月后再测一次，变化会比数字本身更有参考价值。</li>";

      $("analyzing").classList.remove("show");
      show("result");
    },1000);
  }

  $("startBtn").addEventListener("click",function(){
    var v = parseInt($("ageInput").value,10);
    if(!isFinite(v) || v<10 || v>90){
      $("formError").classList.add("show");
      $("ageInput").focus();
      return;
    }
    $("formError").classList.remove("show");
    actualAge = v;
    answers = new Array(30).fill(null);
    current = 0;
    renderQuiz();
    show("quiz");
  });

  $("ageInput").addEventListener("keydown",function(e){
    if(e.key==="Enter") $("startBtn").click();
  });
  $("ageInput").addEventListener("input",function(){
    $("formError").classList.remove("show");
  });

  $("nextBtn").addEventListener("click",function(){
    clearTimeout(advanceTimer);
    if(answers[current]===null) return;
    if(current<questions.length-1){ current++; renderQuiz(); }
    else finish();
  });

  $("prevBtn").addEventListener("click",function(){
    clearTimeout(advanceTimer);
    if(current>0){ current--; renderQuiz(); }
  });

  $("restartBtn").addEventListener("click",function(){
    clearTimeout(resultTimer);
    clearTimeout(advanceTimer);
    $("analyzing").classList.remove("show");
    answers = new Array(30).fill(null);
    current = 0;
    $("ageInput").value = "";
    show("intro");
  });
})();
</script>
</body>
</html>
