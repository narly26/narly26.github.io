<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#F6F5F1">
<meta name="description" content="心理年龄测试 —— 30 道题，读懂你的心态年龄与真实年龄之间的距离。">
<title>心理年龄测试</title>
<style>
  :root{
    --bg:#F6F5F1;
    --surface:#FFFFFF;
    --ink:#20201E;
    --muted:#7C7870;
    --line:#E8E5DD;
    --accent:#2F5148;
    --accent-soft:#EDF2EE;
    --gold:#B18A57;
    --gold-soft:#F7F1E7;
    --shadow:0 12px 34px rgba(40,38,32,.05);
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  html,body{margin:0;padding:0}
  body{
    background:radial-gradient(900px 520px at 12% -10%,#FFFFFF 0%,rgba(255,255,255,0) 62%),var(--bg);
    color:var(--ink);
    font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
    -webkit-font-smoothing:antialiased;
    min-height:100vh;
    position:relative;
    overflow-x:hidden;
  }
  .ambient{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden}
  .orb{
    position:absolute;border-radius:50%;filter:blur(70px);opacity:.45;
    animation:drift 19s ease-in-out infinite alternate;
  }
  .orb.a{width:300px;height:300px;background:#DCE8DF;top:-110px;left:-100px}
  .orb.b{width:250px;height:250px;background:#F1E4D1;bottom:6%;right:-120px;animation-delay:-7s}
  .orb.c{width:200px;height:200px;background:#E2E6F0;top:44%;left:-140px;animation-delay:-13s}
  @keyframes drift{
    from{transform:translate3d(0,0,0) scale(1)}
    to{transform:translate3d(28px,36px,0) scale(1.14)}
  }
  button,input{font:inherit}
  button{cursor:pointer}
  .app{
    position:relative;
    z-index:1;
    max-width:520px;
    min-height:100vh;
    margin:0 auto;
    padding:0 22px calc(30px + env(safe-area-inset-bottom));
    display:flex;
    flex-direction:column;
  }
  .topbar{
    height:66px;
    flex:0 0 auto;
    display:flex;
    align-items:center;
    justify-content:space-between;
    border-bottom:1px solid var(--line);
  }
  .brand{display:flex;align-items:center;gap:10px;font-size:13px;letter-spacing:.14em;color:var(--ink)}
  .brand-mark{
    width:24px;height:24px;border-radius:7px;background:var(--ink);color:#fff;
    display:flex;align-items:center;justify-content:center;font-size:13px;letter-spacing:0;
    animation:breathe 4.2s ease-in-out infinite;
  }
  @keyframes breathe{
    0%,100%{transform:scale(1);box-shadow:0 0 0 0 rgba(47,81,72,.18)}
    50%{transform:scale(1.07);box-shadow:0 0 0 7px rgba(47,81,72,0)}
  }
  .top-hint{font-size:11px;color:var(--muted);letter-spacing:.1em}
  main{flex:1 1 auto;padding-top:26px}
  .screen{display:none}
  .screen.active{display:block;animation:rise .5s cubic-bezier(.22,1,.36,1) backwards}
  @keyframes rise{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
  #intro > *{animation:staggerIn .68s cubic-bezier(.22,1,.36,1) backwards}
  #intro > *:nth-child(1){animation-delay:.04s}
  #intro > *:nth-child(2){animation-delay:.10s}
  #intro > *:nth-child(3){animation-delay:.16s}
  #intro > *:nth-child(4){animation-delay:.22s}
  #intro > *:nth-child(5){animation-delay:.28s}
  #intro > *:nth-child(6){animation-delay:.34s}
  #intro > *:nth-child(7){animation-delay:.40s}
  #intro > *:nth-child(8){animation-delay:.46s}
  #intro > *:nth-child(9){animation-delay:.52s}
  #intro > *:nth-child(10){animation-delay:.58s}
  @keyframes staggerIn{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
  #intro > .title-rule{animation:growRule .85s .5s cubic-bezier(.22,1,.36,1) backwards}

  /* 首页 */
  .eyebrow{font-size:11px;letter-spacing:.32em;color:var(--gold);margin:34px 0 18px}
  .title{
    font-family:"Noto Serif SC","Songti SC","STSong",serif;
    font-size:40px;line-height:1.25;font-weight:600;letter-spacing:.04em;margin:0;
  }
  .title-rule{
    width:42px;height:2px;background:var(--accent);margin:22px 0 20px;
    transform-origin:left center;animation:growRule .85s .5s cubic-bezier(.22,1,.36,1) backwards;
  }
  @keyframes growRule{from{transform:scaleX(0)}to{transform:scaleX(1)}}
  .lead{font-size:14px;line-height:1.9;color:var(--muted);margin:0;max-width:330px}
  .meta{display:flex;gap:16px;margin:26px 0 38px;font-size:12px;color:var(--muted)}
  .meta span{display:flex;align-items:center;gap:6px}
  .meta i{width:3px;height:3px;border-radius:50%;background:var(--gold);display:inline-block}
  .field-label{display:block;font-size:12px;color:var(--muted);letter-spacing:.08em;margin-bottom:10px}
  .age-field{
    display:flex;align-items:center;background:var(--surface);border:1px solid var(--line);
    border-radius:14px;padding:0 18px;height:58px;transition:border-color .2s,box-shadow .2s;
  }
  .age-field:focus-within{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}
  .age-field input{
    flex:1;min-width:0;border:0;outline:0;background:transparent;font-size:22px;color:var(--ink);
    font-family:"Noto Serif SC","Songti SC",serif;
  }
  .age-field input::placeholder{color:#C7C3BA}
  .age-field em{font-style:normal;font-size:14px;color:var(--muted)}
  .form-error{min-height:20px;font-size:12px;color:#B4604F;padding-top:7px;opacity:0;transition:opacity .2s}
  .form-error.show{opacity:1}
  #intro > .form-error{animation:none}
  .primary{
    width:100%;height:56px;border:0;border-radius:14px;background:var(--ink);color:#fff;
    font-size:14px;letter-spacing:.18em;transition:transform .18s,opacity .18s;
  }
  .primary:active{transform:scale(.985)}
  .primary:disabled{opacity:.36;cursor:not-allowed}
  .fine-print{font-size:11px;line-height:1.8;color:#A5A097;text-align:center;margin-top:16px}

  /* 答题 */
  .progress-track{height:3px;background:var(--line);border-radius:9px;overflow:hidden;margin-top:6px}
  .progress-fill{
    position:relative;overflow:hidden;height:100%;width:0;background:var(--accent);
    border-radius:9px;transition:width .42s cubic-bezier(.22,1,.36,1);
  }
  .progress-fill:after{
    content:"";position:absolute;inset:0;
    background:linear-gradient(90deg,transparent,rgba(255,255,255,.55),transparent);
    animation:sheen 2.4s linear infinite;
  }
  @keyframes sheen{from{transform:translateX(-100%)}to{transform:translateX(100%)}}
  .quiz-head{display:flex;align-items:center;justify-content:space-between;margin:26px 0 12px}
  .step{font-size:12px;letter-spacing:.12em;color:var(--muted)}
  .step strong{font-family:"Noto Serif SC","Songti SC",serif;font-size:20px;color:var(--ink);font-weight:600}
  .dim-chip{font-size:11px;color:var(--accent);background:var(--accent-soft);padding:6px 11px;border-radius:20px;letter-spacing:.06em}
  .question{
    font-family:"Noto Serif SC","Songti SC",serif;
    font-size:22px;line-height:1.6;font-weight:600;margin:6px 0 26px;
  }
  .question.swap{animation:questionSwap .42s cubic-bezier(.22,1,.36,1)}
  @keyframes questionSwap{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
  .options{display:flex;flex-direction:column;gap:11px}
  .option{
    display:flex;align-items:center;gap:14px;width:100%;min-height:64px;
    background:var(--surface);border:1px solid var(--line);border-radius:14px;
    padding:13px 16px;text-align:left;color:var(--ink);font-size:14px;line-height:1.6;
    transition:border-color .2s,background .2s,transform .18s,box-shadow .2s;
    animation:optionIn .45s cubic-bezier(.22,1,.36,1) backwards;
  }
  @keyframes optionIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
  .option:hover{border-color:#CBD8D0;transform:translateX(3px)}
  .option:active{transform:scale(.985)}
  .option .key{
    flex:0 0 28px;width:28px;height:28px;border-radius:50%;border:1px solid var(--line);
    display:flex;align-items:center;justify-content:center;font-size:12px;color:var(--muted);
    transition:all .2s;
  }
  .option.selected{
    border-color:var(--accent);background:var(--accent-soft);
    box-shadow:0 6px 18px rgba(47,81,72,.08);
  }
  .option.selected .key{
    background:var(--accent);border-color:var(--accent);color:#fff;
    animation:keyPop .42s cubic-bezier(.34,1.56,.64,1);
  }
  @keyframes keyPop{0%{transform:scale(.65)}60%{transform:scale(1.16)}100%{transform:scale(1)}}
  .nav{display:flex;gap:12px;margin-top:30px}
  .ghost{
    flex:0 0 96px;height:50px;border-radius:13px;border:1px solid var(--line);
    background:transparent;color:var(--muted);font-size:13px;
  }
  .ghost:disabled{opacity:.35;cursor:not-allowed}
  .nav .primary{flex:1;height:50px}

  /* 结果 */
  #result > *{animation:resultIn .62s cubic-bezier(.22,1,.36,1) backwards}
  #result > *:nth-child(1){animation-delay:.04s}
  #result > *:nth-child(2){animation-delay:.09s}
  #result > *:nth-child(3){animation-delay:.14s}
  #result > *:nth-child(4){animation-delay:.19s}
  #result > *:nth-child(5){animation-delay:.24s}
  #result > *:nth-child(6){animation-delay:.29s}
  #result > *:nth-child(7){animation-delay:.34s}
  #result > *:nth-child(8){animation-delay:.39s}
  @keyframes resultIn{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
  #result > .diff-pill{animation:popIn .55s .3s cubic-bezier(.34,1.56,.64,1) backwards}
  .result-label{text-align:center;font-size:11px;letter-spacing:.3em;color:var(--muted);margin-top:12px}
  .age-hero{
    margin-top:12px;background:var(--surface);border:1px solid var(--line);border-radius:20px;
    box-shadow:var(--shadow);padding:32px 22px 28px;text-align:center;
  }
  .age-number{
    font-family:"Noto Serif SC","Songti SC",serif;font-size:74px;line-height:1;
    font-weight:600;letter-spacing:-.02em;color:var(--accent);
    animation:numberGlow 3.4s ease-in-out infinite;
  }
  @keyframes numberGlow{
    0%,100%{text-shadow:0 0 0 rgba(47,81,72,0)}
    50%{text-shadow:0 0 20px rgba(47,81,72,.13)}
  }
  .age-number small{font-size:20px;margin-left:4px;font-weight:400}
  .profile-tag{
    display:inline-block;margin-top:18px;padding:7px 16px;border-radius:20px;
    font-size:12px;letter-spacing:.12em;background:var(--accent-soft);color:var(--accent);
  }
  .profile-tag.old{background:var(--gold-soft);color:var(--gold)}
  .hero-desc{font-size:13px;line-height:1.9;color:var(--muted);margin:16px auto 0;max-width:310px}
  .compare{margin-top:18px;background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:20px}
  .compare-row{display:flex;align-items:center;justify-content:space-between}
  .compare-item{flex:1;text-align:center}
  .compare-item span{display:block;font-size:11px;color:var(--muted);letter-spacing:.1em}
  .compare-item b{display:block;font-family:"Noto Serif SC","Songti SC",serif;font-size:26px;font-weight:600;margin-top:6px}
  .compare-arrow{flex:0 0 56px;color:#C3BEB4;font-size:19px;text-align:center}
  .diff-pill{
    margin-top:18px;text-align:center;font-size:12px;letter-spacing:.08em;padding:9px;border-radius:10px;
    background:var(--accent-soft);color:var(--accent);
    animation:popIn .55s .3s cubic-bezier(.34,1.56,.64,1) backwards;
  }
  @keyframes popIn{from{opacity:0;transform:scale(.9)}to{opacity:1;transform:scale(1)}}
  .diff-pill.old{background:var(--gold-soft);color:var(--gold)}
  .diff-pill.same{background:#F2F1ED;color:var(--muted)}
  .scale{position:relative;height:76px;margin:16px 3px 0}
  .scale-line{position:absolute;top:24px;left:0;right:0;height:6px;border-radius:6px;background:#ECE9E2}
  .scale-fill{position:absolute;top:24px;height:6px;border-radius:6px;background:linear-gradient(90deg,#7FA095,#2F5148)}
  .marker{
    position:absolute;top:17px;width:20px;height:20px;border-radius:50%;background:var(--accent);
    border:4px solid #fff;box-shadow:0 2px 8px rgba(0,0,0,.14);transform:translateX(-50%);
    animation:markerIn .55s .42s cubic-bezier(.34,1.56,.64,1) backwards;
  }
  #mindMarker{animation-delay:.58s}
  @keyframes markerIn{
    from{opacity:0;transform:translateX(-50%) translateY(-10px) scale(.5)}
    to{opacity:1;transform:translateX(-50%) translateY(0) scale(1)}
  }
  .marker.actual{background:#B7B2A8}
  .marker-label{position:absolute;top:45px;transform:translateX(-50%);font-size:11px;color:var(--muted);white-space:nowrap}
  .scale-end{position:absolute;top:62px;font-size:10px;color:#B4AFA5}
  .scale-end.l{left:0}.scale-end.r{right:0}
  .block{margin-top:30px}
  .block h3{
    font-family:"Noto Serif SC","Songti SC",serif;font-size:17px;font-weight:600;letter-spacing:.06em;
    margin:0 0 14px;padding-left:12px;border-left:2px solid var(--accent);
  }
  .block p{font-size:13.5px;line-height:2;color:#55514A;margin:0 0 12px}
  .block p b{color:var(--ink);font-weight:600}
  .dim-row{margin-bottom:15px}
  .dim-top{display:flex;justify-content:space-between;font-size:12px;color:#55514A;margin-bottom:7px}
  .dim-top span:last-child{color:var(--muted);font-variant-numeric:tabular-nums}
  .dim-track{height:5px;background:#ECE9E2;border-radius:5px;overflow:hidden}
  .dim-fill{height:100%;border-radius:5px;background:var(--accent);width:0;transition:width .9s cubic-bezier(.22,1,.36,1)}
  .dim-fill.low{background:#C0A47E}
  .tips{margin:0;padding:0;list-style:none;counter-reset:tip}
  .tips li{
    position:relative;padding-left:30px;margin-bottom:13px;font-size:13px;line-height:1.85;color:#55514A;
  }
  .tips li:before{
    counter-increment:tip;content:counter(tip);position:absolute;left:0;top:2px;
    width:20px;height:20px;border-radius:50%;background:var(--accent-soft);color:var(--accent);
    font-size:10px;display:flex;align-items:center;justify-content:center;
  }
  /* 深度分析 */
  .subhead{
    font-size:11px;letter-spacing:.18em;color:var(--gold);margin:22px 0 10px;
  }
  .subhead:first-child{margin-top:0}
  .diff-story{
    background:var(--surface);border:1px solid var(--line);border-left:3px solid var(--accent);
    border-radius:12px;padding:14px 16px;font-size:12.5px;line-height:1.95;color:#57534B;
  }
  .diff-story.old{border-left-color:var(--gold)}
  .insight{
    background:var(--surface);border:1px solid var(--line);border-radius:14px;
    padding:15px 16px 4px;margin-bottom:12px;
  }
  .insight-head{display:flex;align-items:center;gap:9px;margin-bottom:9px}
  .insight-dot{flex:0 0 8px;width:8px;height:8px;border-radius:50%;background:var(--accent)}
  .insight-dot.gold{background:#C0A47E}
  .insight-head h4{margin:0;font-size:13.5px;font-weight:600;flex:1}
  .insight-head em{font-style:normal;font-size:11px;color:var(--muted);font-variant-numeric:tabular-nums}
  .insight p{font-size:12.5px;line-height:1.95;color:#57534B;margin:0 0 9px}
  .insight p span{color:var(--ink);font-weight:600}
  .insight-bar{height:4px;background:#ECE9E2;border-radius:4px;overflow:hidden;margin-bottom:12px}
  .insight-bar i{display:block;height:100%;background:var(--accent);border-radius:4px;width:0;transition:width .9s cubic-bezier(.22,1,.36,1)}
  .insight-bar i.gold{background:#C0A47E}
  .disclaimer{
    margin-top:28px;padding:14px 16px;border:1px dashed var(--line);border-radius:12px;
    font-size:11px;line-height:1.8;color:#A29D93;
  }
  /* 生成报告的过渡 */
  .analyzing{
    position:fixed;inset:0;z-index:30;display:flex;flex-direction:column;
    align-items:center;justify-content:center;
    background:rgba(246,245,241,.94);backdrop-filter:blur(10px);
    opacity:0;visibility:hidden;transition:opacity .38s,visibility .38s;
  }
  .analyzing.show{opacity:1;visibility:visible}
  .analyzing .ring{
    width:74px;height:74px;border-radius:50%;border:2px solid var(--line);
    border-top-color:var(--accent);animation:spin 1.05s linear infinite;
  }
  @keyframes spin{to{transform:rotate(360deg)}}
  .analyzing .ring-wrap{position:relative;width:74px;height:74px}
  .analyzing .ring-wrap:after{
    content:"";position:absolute;inset:12px;border-radius:50%;
    border:1px solid var(--line);animation:spin 1.8s linear infinite reverse;
  }
  .analyzing p{
    margin:24px 0 0;font-size:12px;letter-spacing:.24em;color:var(--muted);
    animation:pulseText 1.5s ease-in-out infinite;
  }
  @keyframes pulseText{0%,100%{opacity:.45}50%{opacity:1}}
  .restart{margin-top:22px}
  .footer-note{
    flex:0 0 auto;text-align:center;font-size:10px;color:#B6B1A7;letter-spacing:.1em;padding-top:26px;
  }
  @media (max-width:360px){
    .title{font-size:34px}
    .question{font-size:20px}
    .age-number{font-size:64px}
    .app{padding-left:18px;padding-right:18px}
  }
  @media (prefers-reduced-motion:reduce){
    *{animation:none!important;transition:none!important}
  }
</style>
</head>
<body>
<div class="ambient" aria-hidden="true"><span class="orb a"></span><span class="orb b"></span><span class="orb c"></span></div>
<div class="analyzing" id="analyzing" aria-live="polite">
  <div class="ring-wrap"><div class="ring"></div></div>
  <p>正在读懂你的答案</p>
</div>
<div class="app">
  <header class="topbar">
    <div class="brand"><span class="brand-mark">心</span><span>MIND AGE</span></div>
    <div class="top-hint" id="topHint">自我探索 · 01</div>
  </header>

  <main>
    <!-- 首页 -->
    <section class="screen active" id="intro">
      <div class="eyebrow">A QUIET LOOK INWARD</div>
      <h1 class="title">心理年龄<br>测试</h1>
      <div class="title-rule"></div>
      <p class="lead">年龄记录时间，心态定义状态。用 30 道题，看看你的内心正站在哪个年纪。</p>
      <div class="meta">
        <span><i></i>30 道选择题</span>
        <span><i></i>约 3 分钟</span>
        <span><i></i>6 个心理维度</span>
      </div>
      <label class="field-label" for="ageInput">你的实际年龄</label>
      <div class="age-field">
        <input id="ageInput" type="number" inputmode="numeric" min="10" max="90" placeholder="请输入年龄" aria-label="实际年龄">
        <em>岁</em>
      </div>
      <div class="form-error" id="formError">请输入 10 至 90 之间的年龄</div>
      <button class="primary" id="startBtn" type="button">开始测试</button>
      <div class="fine-print">答案仅在你的浏览器中计算，不会被上传或保存</div>
    </section>

    <!-- 答题 -->
    <section class="screen" id="quiz">
      <div class="progress-track"><div class="progress-fill" id="progressFill"></div></div>
      <div class="quiz-head">
        <div class="step">第 <strong id="stepNow">01</strong> / 30 题</div>
        <div class="dim-chip" id="dimChip">情绪与心态</div>
      </div>
      <h2 class="question" id="questionText"></h2>
      <div class="options" id="options"></div>
      <div class="nav">
        <button class="ghost" id="prevBtn" type="button">上一题</button>
        <button class="primary" id="nextBtn" type="button" disabled>下一题</button>
      </div>
    </section>

    <!-- 结果 -->
    <section class="screen" id="result">
      <div class="result-label">你的心理年龄</div>
      <div class="age-hero">
        <div class="age-number" id="psyAge">0<small>岁</small></div>
        <div class="profile-tag" id="profileTag">同龄同行者</div>
        <p class="hero-desc" id="heroDesc"></p>
      </div>

      <div class="compare">
        <div class="compare-row">
          <div class="compare-item"><span>实际年龄</span><b id="realAge">0 岁</b></div>
          <div class="compare-arrow">→</div>
          <div class="compare-item"><span>心理年龄</span><b id="mindAge">0 岁</b></div>
        </div>
        <div class="diff-pill" id="diffPill">与你的实际年龄基本一致</div>
        <div class="scale" id="scale">
          <div class="scale-line"></div>
          <div class="scale-fill" id="scaleFill"></div>
          <div class="marker actual" id="actualMarker"></div>
          <div class="marker" id="mindMarker"></div>
          <div class="marker-label" id="actualLabel">实际</div>
          <div class="marker-label" id="mindLabel">心理</div>
          <div class="scale-end l" id="scaleLow"></div>
